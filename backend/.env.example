# Oracle Database Configuration
ORACLE_USER=smart_expense
ORACLE_PASSWORD=your_oracle_password
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=XEPDB1

# SQLAlchemy Database URL (URL-encode special characters in password, e.g. '#' -> '%23')
DATABASE_URL=oracle+oracledb://smart_expense:your_oracle_password@localhost:1521/?service_name=XEPDB1

# JWT Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Paths
ML_MODELS_DIR=../ml/models
ML_RESULTS_PATH=../ml/evaluation/results.json
